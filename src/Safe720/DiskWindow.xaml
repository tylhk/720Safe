<Window x:Class="Safe720.DiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Safe720"
        Title="C 盘空间分析 - 720安全大王" Width="760" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F7FA">
    <Window.Resources>
        <!-- 大小在最左侧固定宽度，树的缩进不会把它挤乱 -->
        <HierarchicalDataTemplate DataType="{x:Type local:SpaceItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding SizeText}" Width="72" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ProgressBar Value="{Binding Percent, Mode=OneTime}" Maximum="100" Width="60" Height="7" Margin="10,0"
                             VerticalAlignment="Center" Foreground="SteelBlue" Background="#E5E7EB" BorderThickness="0"/>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding GlyphBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Extra}" Foreground="#9CA3AF" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Hint}" Foreground="#D97706" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="在资源管理器中打开" Click="OpenInExplorer_Click"/>
            <MenuItem Header="复制路径" Click="CopyPath_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="DiskText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="DiskBar" Height="8" Margin="0,6,0,0" Maximum="100"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#374151"
                       TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
            <Button x:Name="ScanButton" Content="开始扫描" Padding="14,5" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Scan_Click"/>
        </Grid>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#DDE2EA">
            <TabItem Header="按文件夹">
                <TreeView x:Name="Tree" BorderThickness="0" Padding="4"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ContextMenu="{StaticResource ItemMenu}"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                          MouseDoubleClick="Tree_MouseDoubleClick"/>
            </TabItem>
            <TabItem Header="最大的文件">
                <ListView x:Name="Files" BorderThickness="0" ContextMenu="{StaticResource ItemMenu}"
                          MouseDoubleClick="Files_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="大小" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="文件名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="修改时间" Width="96" DisplayMemberBinding="{Binding Modified}"/>
                            <GridViewColumn Header="说明 / 位置" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Folder}" Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}"/>
                                            <TextBlock Text="{Binding Hint}" Foreground="#D97706" FontSize="12" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="展开文件夹查看里面谁最占空间；双击文件或右键可在资源管理器中打开。本工具只做分析，不会删除任何文件。"/>
    </Grid>
</Window>
