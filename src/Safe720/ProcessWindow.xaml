<Window x:Class="Safe720.ProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高占用程序 - 720安全大王" Width="620" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="SystemText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="排序：" VerticalAlignment="Center" Foreground="#374151"/>
                <RadioButton x:Name="SortCpu" Content="CPU" Margin="4,0" VerticalAlignment="Center" Checked="Sort_Checked"/>
                <RadioButton x:Name="SortMem" Content="内存" Margin="4,0" VerticalAlignment="Center" Checked="Sort_Checked"/>
                <RadioButton x:Name="SortDisk" Content="磁盘" Margin="4,0,0,0" VerticalAlignment="Center" Checked="Sort_Checked"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 表头，列宽与下方行模板一致 -->
                <Grid Margin="12,8,12,6" TextElement.Foreground="#6B7280" TextElement.FontSize="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="程序"/>
                    <TextBlock Grid.Column="1" Text="CPU" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="内存" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="磁盘" TextAlignment="Right"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List" Margin="4,0,4,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"/>
                                        <TextBlock Text="{Binding Sub}" Foreground="#6B7280" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Cpu}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Mem}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Disk}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="结束" Padding="10,2" Style="{StaticResource DangerButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanKill}" ToolTip="{Binding KillTip}" ToolTipService.ShowOnDisabled="True"
                                            Click="Kill_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,180,0"
                       Text="每 2 秒刷新。同名的多个进程合并显示、一起结束（dotnet、python 等按脚本分开）；系统进程不能结束。"/>
            <Button Content="查看卡顿日志" Padding="14,5" HorizontalAlignment="Right" Click="StallLog_Click"/>
        </Grid>
    </Grid>
</Window>
