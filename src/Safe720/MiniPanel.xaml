<Window x:Class="Safe720.MiniPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Safe720.Controls"
        Title="720安全大王" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Opacity="0"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#E6EAF2">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9AA6B8"/>

        <!-- 右上角小图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#9AA6B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部功能格：Tag = 图标字形，Background/Foreground = 图标底色/颜色 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F7FB8FF"/>
            <Setter Property="Foreground" Value="#8CC4FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="2,9,2,8">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{TemplateBinding Background}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Margin="0,6,0,0" HorizontalAlignment="Center"
                                                  TextElement.FontSize="11.5" TextElement.Foreground="#C9D1DE"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#7FB8FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter TextElement.FontSize="12"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外边距留给阴影 -->
    <Border x:Name="Card" Margin="18" Width="304" CornerRadius="16" Padding="18,14,18,12"
            BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#252E3F" Offset="0"/>
                <GradientStop Color="#151A25" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.94" ScaleY="0.94"/>
        </Border.RenderTransform>

        <StackPanel>
            <!-- 标题 -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Safe720;component/Assets/logo64.png" Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="720安全大王" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Tag="settings" Click="Action_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="关闭（Esc）" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusLine" Margin="18,2,0,0" FontSize="12" Text="正在检测…" Foreground="{StaticResource Muted}"/>

            <!-- 内存 / CPU 仪表 -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ctl:RingGauge x:Name="MemGauge" Label="内存" Width="104" Height="104"/>
                    <TextBlock x:Name="MemText" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <ctl:RingGauge x:Name="CpuGauge" Label="CPU" Width="104" Height="104"/>
                    <TextBlock x:Name="CpuText" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>

            <!-- C 盘 -->
            <Border Margin="0,14,0,0" CornerRadius="10" Background="#12FFFFFF" Padding="12,10">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" Foreground="#8CC4FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DiskName" Text="C 盘" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="DiskText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="DiskTrack" Height="6" Margin="0,8,0,0">
                        <Border CornerRadius="3" Background="#26FFFFFF"/>
                        <Border x:Name="DiskFill" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush x:Name="DiskFillBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#4DDBFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 占用最高 -->
            <Grid Margin="2,14,2,4">
                <TextBlock Text="占用最高" FontSize="12" Foreground="{StaticResource Muted}"/>
                <Button Style="{StaticResource LinkButton}" Content="全部程序 ›" HorizontalAlignment="Right" Tag="process" Click="Action_Click"/>
            </Grid>
            <!-- 固定三行高度：数据出来前显示骨架占位条，出来后原地替换，面板不会被撑高 -->
            <Grid Height="72" Margin="2,0">
                <ItemsControl x:Name="TopList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Cpu}" TextAlignment="Right" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{Binding CpuBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Mem}" TextAlignment="Right" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="TopPlaceholder">
                    <StackPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="CornerRadius" Value="5"/>
                            <Setter Property="Background" Value="#1CFFFFFF"/>
                            <Setter Property="Margin" Value="0,7"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                    </StackPanel.Resources>
                    <Border Width="210"/>
                    <Border Width="170"/>
                    <Border Width="190"/>
                </StackPanel>
            </Grid>

            <!-- 功能 -->
            <Border Height="1" Background="#1FFFFFFF" Margin="0,12,0,6"/>
            <UniformGrid Columns="4">
                <Button Style="{StaticResource ActionButton}" Tag="&#xE945;" Content="一键加速" Click="Action_Click" x:Name="BoostButton"
                        Foreground="White">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2ECC71" Offset="0"/>
                            <GradientStop Color="#1FA5D6" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Style="{StaticResource ActionButton}" Tag="&#xE74D;" Content="垃圾清理" Click="Action_Click"/>
                <Button Style="{StaticResource ActionButton}" Tag="&#xEDA2;" Content="空间分析" Click="Action_Click"/>
                <Button Style="{StaticResource ActionButton}" Tag="&#xE71D;" Content="软件卸载" Click="Action_Click"/>
                <Button Style="{StaticResource ActionButton}" Tag="&#xE823;" Content="启动项" Click="Action_Click"/>
                <Button Style="{StaticResource ActionButton}" Tag="&#xE9D9;" Content="高占用" Click="Action_Click"/>
                <Button Style="{StaticResource ActionButton}" Tag="&#xE894;" Content="清临时文件" Click="Action_Click"/>
                <Button Style="{StaticResource ActionButton}" Tag="&#xED1A;" Content="隐藏球" Click="Action_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
