<Window x:Class="Safe720.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - 720安全大王" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20,6,20,20">
        <TextBlock Text="悬浮球" Style="{StaticResource Group}"/>
        <Border Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="4" Padding="12,6">
            <StackPanel>
                <CheckBox x:Name="ChkBallVisible" Content="显示悬浮球（隐藏后单击托盘图标恢复）" Click="Changed"/>
                <CheckBox x:Name="ChkTopmost" Content="悬浮球总在最前" Click="Changed"/>
                <CheckBox x:Name="ChkEdgeDock" Content="拖到屏幕边缘时贴边，缩进一半" Click="Changed"/>
                <CheckBox x:Name="ChkAutoHideFullscreen" Content="全屏（看视频、玩游戏、放映）时自动隐藏" Click="Changed"/>
                <CheckBox x:Name="ChkAutostart" Content="开机自动启动" Click="Changed"/>
            </StackPanel>
        </Border>

        <TextBlock Text="清理与提醒" Style="{StaticResource Group}"/>
        <Border Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="4" Padding="12,6">
            <StackPanel>
                <CheckBox x:Name="ChkAutoCleanTemp" Content="每天自动清理临时文件（超过 24 小时的）" Click="Changed"/>
                <CheckBox x:Name="ChkDiskAlert" Content="C 盘空间不足时提醒" Click="Changed"/>
                <CheckBox x:Name="ChkStallRecorder" Content="记录卡顿（写入卡顿日志）" Click="Changed"/>
                <CheckBox x:Name="ChkStallNotify" Content="卡顿时通知，并可一键结束占用高的程序" Margin="22,4,0,4"
                          IsEnabled="{Binding IsChecked, ElementName=ChkStallRecorder}" Click="Changed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
