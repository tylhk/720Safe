<Window x:Class="Safe720.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动项管理 - 720安全大王" Width="600" Height="520" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#374151" Margin="0,0,0,10">
            取消勾选 = 开机不再自动启动（下次开机生效）。与任务管理器"启动"页同一机制，可随时重新勾选恢复，不会删除程序。
        </TextBlock>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                          VerticalAlignment="Top" Margin="0,3,10,0" Click="Toggle_Click" Tag="{Binding}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Command}" Foreground="#6B7280" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                    <TextBlock Text="{Binding Hint}" Foreground="#D97706" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#6B7280" FontSize="12"
                                           Margin="12,2,0,0" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#374151"/>
            <Button Content="刷新" Padding="14,5" HorizontalAlignment="Right" Click="Refresh_Click"/>
        </Grid>
    </Grid>
</Window>
