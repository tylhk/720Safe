<Window x:Class="Safe720.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Safe720.Controls"
        Title="720安全大王" Height="80" Width="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid>
        <ctl:LiquidBall x:Name="Ball" Margin="4"/>
        <Path x:Name="HitArea" Fill="Transparent" Stretch="Fill">
            <Path.Data>
                <EllipseGeometry RadiusX="1" RadiusY="1"/>
            </Path.Data>
        </Path>
    </Grid>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="垃圾清理…" Click="MenuJunk_Click"/>
            <MenuItem Header="启动项管理…" Click="MenuStartup_Click"/>
            <MenuItem Header="清理临时文件" Click="MenuCleanTemp_Click"/>
            <MenuItem Header="查看卡顿日志" Click="MenuStallLog_Click"/>
            <Separator/>
            <MenuItem Header="设置">
                <MenuItem x:Name="MenuAutoClean" Header="每天自动清理临时文件" IsCheckable="True" Click="MenuAutoClean_Click"/>
                <MenuItem x:Name="MenuDiskAlert" Header="C 盘空间不足提醒" IsCheckable="True" Click="MenuDiskAlert_Click"/>
                <MenuItem x:Name="MenuStall" Header="记录卡顿" IsCheckable="True" Click="MenuStall_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuTopmost" Header="置顶" IsCheckable="True" IsChecked="True" Click="MenuTopmost_Click"/>
                <MenuItem x:Name="MenuAutostart" Header="开机自启" IsCheckable="True" Click="MenuAutostart_Click"/>
            </MenuItem>
            <MenuItem Header="以管理员身份重启" Click="MenuRelaunchAdmin_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
